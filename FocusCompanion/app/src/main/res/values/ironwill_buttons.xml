<resources>
    <style name="IronWillEmeraldButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/ironwill_connect_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">10dp</item>
        <item name="android:outlineSpotShadowColor">@color/iw_emerald_glow</item>
        <item name="android:outlineAmbientShadowColor">@color/iw_emerald_glow</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IronWillGhostButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/ironwill_diagnostic_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IronWillDiagnosticButton" parent="IronWillGhostButton" />
</resources>
