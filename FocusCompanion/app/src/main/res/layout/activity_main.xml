<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Companion"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <!-- Main Connect Button -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Connect to PC"
        android:textSize="16sp"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Optional Accessibility Button -->
    <Button
        android:id="@+id/accessibilityBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Enable Accessibility"
        android:textSize="16sp"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/notificationAccessBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Enable Notification Access" />
    <Button
        android:id="@+id/testVibrationBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test vibration" />
</LinearLayout>
